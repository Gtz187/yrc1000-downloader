{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "YASKAWA INFORM",
  "scopeName": "source.yaskawa-inform",
  "patterns": [
    { "include": "#header" },
    { "include": "#positions" },
    { "include": "#comment" },
    { "include": "#label" },
    { "include": "#string" },
    { "include": "#keywords" },
    { "include": "#parameters" },
    { "include": "#variables" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "header": {
      "patterns": [
        {
          "match": "^(//NAME)\\s+(\\S+)",
          "captures": {
            "1": { "name": "keyword.other.directive.inform" },
            "2": { "name": "entity.name.function.inform" }
          }
        },
        {
          "match": "^(/{1,3}[A-Z][A-Z0-9_]*)(.*)$",
          "captures": {
            "1": { "name": "keyword.other.directive.inform" },
            "2": { "name": "string.unquoted.header-value.inform" }
          }
        },
        {
          "match": "^(NOP|END)\\s*$",
          "name": "keyword.control.program.inform"
        }
      ]
    },
    "positions": {
      "match": "^((?:B|E)?[CP]\\d{3,5})(=)(.*)$",
      "captures": {
        "1": { "name": "variable.other.position.inform" },
        "2": { "name": "keyword.operator.assignment.inform" },
        "3": { "name": "constant.numeric.position-data.inform" }
      }
    },
    "comment": {
      "match": "'.*$",
      "name": "comment.line.apostrophe.inform"
    },
    "label": {
      "match": "\\*[A-Za-z0-9_]+",
      "name": "entity.name.label.inform"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.inform"
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:NOP|END|CALL|JUMP|RET|IF|ELSEIF|ELSE|ENDIF|WHILE|ENDWHILE|FOR|NEXT|TO|STEP|SWITCH|CASE|DEFAULT|ENDSWITCH|PAUSE|TIMER|WAIT|CWAIT|UNTIL|NWAIT|JOB|LABEL|CHECK|ABORT|PSTART|PWAIT|TSYNC|MSG|COMMENT|INFORM)\\b",
          "name": "keyword.control.inform"
        },
        {
          "match": "\\b(?:MOVJ|MOVL|MOVC|MOVS|IMOV|SMOVJ|SMOVL|SMOVC|SMOVS|SYMOVJ|SYMOVL|SYMOVC|REFP|SPEED|SFTON|SFTOF|MSHIFT|ARCON|ARCOF|ARCSET|WVON|WVOF|TOOLON|TOOLOF|SPYON|SPYOF|HAND|HSEN|SVSPOT|SVGUNCL|SVDRESS)\\b",
          "name": "support.function.motion.inform"
        },
        {
          "match": "\\b(?:DOUT|DIN|AOUT|AIN|PULSE|ARATION|ARATIOF|SETE|GETE|GETS|SETS|SET|ADD|SUB|MUL|DIV|INC|DEC|AND|OR|NOT|XOR|CNVRT|CLEAR|SQRT|SIN|COS|ATAN|MULMAT|INVMAT|SETFILE|GETFILE|GETPOS|VAL|ASC|CHR\\$|MID\\$|LEN|CAT\\$|STRSTR|ADVINIT|ADVSTOP)\\b",
          "name": "support.function.instruction.inform"
        }
      ]
    },
    "parameters": {
      "match": "\\b(VJ|V|VR|VE|PL|ACC|DEC|T|BV|BVJ|TOOL|UF#|RF#|BF#|ENWAIT|FPT|PLIN|PLOUT|CR|PM)(=|(?=#))",
      "captures": {
        "1": { "name": "variable.parameter.inform" },
        "2": { "name": "keyword.operator.assignment.inform" }
      }
    },
    "variables": {
      "patterns": [
        {
          "match": "\\b(?:OT|IN|OG|IG|OGH|IGH|SOUT|SIN|M|AO|AI|BF|UF|RF)#\\(\\s*\\d+\\s*\\)",
          "name": "support.variable.io.inform"
        },
        {
          "match": "\\bL?(?:BP|EX|B|I|D|R|S|P)\\[?\\d{3,}\\]?\\b",
          "name": "variable.other.inform"
        },
        {
          "match": "\\b(?:B|E)?[CP]\\d{3,5}\\b",
          "name": "variable.other.position.inform"
        },
        {
          "match": "\\b(?:RB|ST|BS)\\d\\b",
          "name": "support.constant.group.inform"
        },
        {
          "match": "\\b(?:ON|OFF)\\b",
          "name": "constant.language.inform"
        }
      ]
    },
    "numbers": {
      "match": "(?<![A-Za-z_])-?\\d+(?:\\.\\d+)?(?![A-Za-z_])",
      "name": "constant.numeric.inform"
    },
    "operators": {
      "match": "<>|<=|>=|=|<|>",
      "name": "keyword.operator.comparison.inform"
    }
  }
}
